# Nonaktifkan eksekusi script PHP di folder ini demi keamanan
<Files *.php>
    deny from all
</Files>

<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Cegah directory listing (mencegah orang lain melihat isi daftar folder)
Options -Indexes
